{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "" //connection string config is in user secrets 
  },
  "Jwt": {
    "Issuer": "SchoolManagementApi",
    "Audience": "SchoolManagementClient",
    "SigningKey": "",
    "ExpiryMinutes": 15
  },
  "RefreshToken": {
    "IdleLifetimeDays": 7,
    "AbsoluteLifetimeDays": 30,
    "RetentionDays": 7,
    "CleanupEnabled": true
  },
  "RefreshTokenCookie": {
    "Name": "__Secure-eschool_rt",
    "Path": "/api/auth",
    "SameSite": "Strict"
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
